{
  "name": "google-tools",
  "version": "0.1.1",
  "description": "Google tools for coding agents: Sheets, Gmail, Drive and Google Cloud.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/google-tools#readme",
  "repository": "https://github.com/craft-agent/google-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "google-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "GOOGLE_TOOLS_TOOLSETS",
        "GOOGLE_TOOLS_READ_ONLY",
        "GOOGLE_TOOLS_TOOLS",
        "GOOGLE_TOOLS_EXCLUDE_TOOLS",
        "GOOGLE_TOOLS_CONFIRM",
        "GOOGLE_TOOLS_UNATTENDED",
        "GOOGLE_TOOLS_GRANTS_DIR",
        "GOOGLE_TOOLS_STATE_DIR",
        "GOOGLE_TOOLS_DOWNLOAD_DIR",
        "GOOGLE_TOOLS_UPLOAD_DIRS",
        "GOOGLE_TOOLS_ENCRYPT_DIRS",
        "GOOGLE_TOOLS_AGE_RECIPIENTS",
        "GOOGLE_TOOLS_GRANT_KEY",
        "XDG_STATE_HOME"
      ]
    }
  }
}
